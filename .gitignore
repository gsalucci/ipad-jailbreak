tools/*.ipa
tools/*.appimage
tools/*.zip
tools/AltServer-x86_64
tools/plumesign-linux-x86_64
tools/plumesign-local
tools/ldid
tools/squashfs-root/
tools/__pycache__/
tools/argvwipe.so
tools/argvtest

# Runtime state
run/
*.log
*.pid
