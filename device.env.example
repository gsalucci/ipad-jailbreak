# Copy to device.env and fill in from the attached device -- device.env is
# gitignored because a UDID and serial identify your hardware.
#   set -a; . ./device.env; set +a

export IPAD_UDID="$(idevice_id -l | head -1)"
export IPAD_SERIAL=""
export IPAD_MODEL="iPad11,6"    # iPad 8th gen, WiFi, A2270
export IPAD_OS="18.5"
export IPAD_BUILD="22F76"
export IPAD_ARCH="arm64e"
export IPAD_NAME=""

alias ipad-info='ideviceinfo -u "$IPAD_UDID"'
