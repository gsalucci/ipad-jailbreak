# Copy to .env and edit. .env is gitignored.

# Your self-hosted anisette server, reachable over HTTPS with a PUBLICLY TRUSTED
# certificate. A private CA cannot work: plumesign's websocket stack is rustls +
# webpki-roots and ignores the system trust store entirely.
#
# It must be EXACTLY 25 bytes, the same length as the literal it replaces inside
# the plumesign binary (https://ani.sidestore.app). A Rust string literal is a
# (pointer, length) pair, so in-place patching needs a byte-for-byte length
# match. https:// is 8 bytes, so the hostname must be 17 characters.
ANISETTE_URL=https://ani.example.co

# LAN address of the machine running anisette, if it is not this one. Only used
# by the docs and the compose file.
ANISETTE_HOST=10.0.0.30
